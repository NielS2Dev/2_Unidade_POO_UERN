<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.TelaController" prefWidth="1280" prefHeight="720" minWidth="1280" minHeight="720" maxWidth="1280" maxHeight="720" stylesheets="@style.css">
  <left>
    <VBox prefWidth="240" spacing="8" styleClass="sidebar">
      <padding><Insets top="24" right="16" bottom="24" left="16"/></padding>
      <Label text="NGameCritics" styleClass="sidebar-logo"><padding><Insets bottom="20" left="6"/></padding></Label>
      <Button fx:id="btnCatalogo" text="Catálogo" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-btn" onAction="#irCatalogo"/>
      <Button fx:id="btnReviews" text="Minhas reviews" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-btn" onAction="#irMinhasReviews"/>
      <Button fx:id="btnAvaliacoes" text="Minhas avaliações" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-btn" onAction="#irMinhasAvaliacoes"/>
      <Button fx:id="btnCadastrar" text="Cadastrar jogo" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-btn nav-btn-active" onAction="#irCadastrarJogo"/>
      <Region VBox.vgrow="ALWAYS"/>
      <Button fx:id="btnSair" text="Sair" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-btn" onAction="#sair"/>
    </VBox>
  </left>
  <center>
    <BorderPane>
      <top>
        <HBox prefHeight="68" alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
          <padding><Insets left="28" right="28"/></padding>
          <Label text="Cadastrar jogo" styleClass="topbar-title"/>
          <Region HBox.hgrow="ALWAYS"/>
          <VBox alignment="CENTER_RIGHT"><Label fx:id="lblNick" text="antoniel" styleClass="field-label"/><Label fx:id="lblNivel" text="Membro" styleClass="muted"/></VBox>
          <StackPane prefWidth="42" prefHeight="42" maxWidth="42" maxHeight="42" styleClass="avatar"><Label fx:id="lblInicial" text="A" styleClass="avatar-text"/></StackPane>
        </HBox>
      </top>
      <center>
        <VBox spacing="16" styleClass="content">
          <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
          <Label text="Cadastrar novo jogo" styleClass="h1"/>
          <HBox spacing="28" styleClass="panel" VBox.vgrow="ALWAYS">
            <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
              <Label text="Nome" styleClass="field-label"/>
              <TextField fx:id="txtNome" promptText="nome do jogo"/>
              <Label text="Preço (R$)" styleClass="field-label"/>
              <TextField fx:id="txtPreco" promptText="0,00"/>
              <Label text="Resumo" styleClass="field-label"/>
              <TextArea fx:id="txtResumo" promptText="resumo do jogo" wrapText="true" prefHeight="150"/>
              <Label text="Capa" styleClass="field-label"/>
              <HBox alignment="CENTER_LEFT" spacing="12"><Button fx:id="btnEscolherCapa" text="Escolher imagem" styleClass="btn-outline" onAction="#escolherCapa"/><Label fx:id="lblCapa" text="nenhum arquivo" styleClass="muted"/></HBox>
            </VBox>
            <VBox spacing="10" prefWidth="380">
              <Label text="Gêneros" styleClass="field-label"/>
              <FlowPane hgap="16" vgap="10">
                <CheckBox fx:id="chkAcao" text="Ação"/><CheckBox fx:id="chkRPG" text="RPG"/><CheckBox fx:id="chkFPS" text="FPS"/><CheckBox fx:id="chkCorrida" text="Corrida"/><CheckBox fx:id="chkLuta" text="Luta"/>
              </FlowPane>
              <Label text="Plataformas" styleClass="field-label"><padding><Insets top="10"/></padding></Label>
              <FlowPane hgap="16" vgap="10">
                <CheckBox fx:id="chkPC" text="PC"/><CheckBox fx:id="chkXbox" text="Xbox"/><CheckBox fx:id="chkPlayStation" text="PlayStation"/><CheckBox fx:id="chkSwitch" text="Switch"/>
              </FlowPane>
              <CheckBox fx:id="chkEmPromocao" text="Em promoção"><padding><Insets top="14"/></padding></CheckBox>
              <Region VBox.vgrow="ALWAYS"/>
              <Label fx:id="lblErro" styleClass="error-label" visible="false" managed="false"/>
              <HBox spacing="12" alignment="CENTER_RIGHT"><Button fx:id="btnCancelar" text="Cancelar" styleClass="btn-outline" onAction="#irCatalogo"/><Button fx:id="btnSalvarJogo" text="Salvar jogo" styleClass="btn-primary" onAction="#salvarJogo"/></HBox>
            </VBox>
          </HBox>
        </VBox>
      </center>
    </BorderPane>
  </center>
</BorderPane>
