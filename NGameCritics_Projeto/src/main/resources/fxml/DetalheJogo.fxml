<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.TelaController" prefWidth="1280" prefHeight="720" minWidth="1280" minHeight="720" maxWidth="1280" maxHeight="720" stylesheets="@style.css">
  <left>
    <VBox prefWidth="240" spacing="8" styleClass="sidebar">
      <padding><Insets top="24" right="16" bottom="24" left="16"/></padding>
      <Label text="NGameCritics" styleClass="sidebar-logo"><padding><Insets bottom="20" left="6"/></padding></Label>
      <Button fx:id="btnCatalogo" text="Catálogo" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-btn nav-btn-active" onAction="#irCatalogo"/>
      <Button fx:id="btnReviews" text="Minhas reviews" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-btn" onAction="#irMinhasReviews"/>
      <Button fx:id="btnAvaliacoes" text="Minhas avaliações" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-btn" onAction="#irMinhasAvaliacoes"/>
      <Button fx:id="btnCadastrar" text="Cadastrar jogo" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-btn" onAction="#irCadastrarJogo"/>
      <Region VBox.vgrow="ALWAYS"/>
      <Button fx:id="btnSair" text="Sair" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-btn" onAction="#sair"/>
    </VBox>
  </left>
  <center>
    <BorderPane>
      <top>
        <HBox prefHeight="68" alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
          <padding><Insets left="28" right="28"/></padding>
          <Label text="Detalhes do jogo" styleClass="topbar-title"/>
          <Region HBox.hgrow="ALWAYS"/>
          <VBox alignment="CENTER_RIGHT"><Label fx:id="lblNick" text="antoniel" styleClass="field-label"/><Label fx:id="lblNivel" text="Membro" styleClass="muted"/></VBox>
          <StackPane prefWidth="42" prefHeight="42" maxWidth="42" maxHeight="42" styleClass="avatar"><Label fx:id="lblInicial" text="A" styleClass="avatar-text"/></StackPane>
        </HBox>
      </top>
      <center>
        <HBox spacing="20" styleClass="content">
          <padding><Insets top="20" right="28" bottom="20" left="28"/></padding>
          <VBox prefWidth="300" spacing="10" styleClass="panel">
            <StackPane prefHeight="260" styleClass="game-cover"><!-- ImageView da capa --></StackPane>
            <VBox spacing="6"><padding><Insets top="6" right="18" bottom="18" left="18"/></padding>
              <Label fx:id="lblNomeJogo" text="Nome do Jogo" styleClass="h1" wrapText="true" style="-fx-font-size: 22px;"/>
              <Label fx:id="lblPlataformas" text="PC • Xbox" styleClass="muted"/>
              <Label fx:id="lblGeneros" text="Ação • RPG" styleClass="muted"/>
              <HBox alignment="CENTER_LEFT"><Label fx:id="lblPreco" text="R$ 199,90" styleClass="game-price"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblNotaMedia" text="★ 4.5" styleClass="game-rating"/></HBox>
              <Label fx:id="lblPromocao" text="PROMOÇÃO" styleClass="badge-promo"/>
              <Label fx:id="lblResumo" text="Resumo do jogo..." wrapText="true" styleClass="muted"/>
            </VBox>
          </VBox>
          <ScrollPane fitToWidth="true" hbarPolicy="NEVER" HBox.hgrow="ALWAYS">
            <VBox spacing="16">
              <padding><Insets bottom="10"/></padding>
              <VBox spacing="8" styleClass="panel"><padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                <Label text="Sua avaliação" styleClass="section-title"/>
                <HBox alignment="CENTER_LEFT" spacing="14">
                  <Slider fx:id="sldNota" min="1" max="5" value="3" majorTickUnit="1" minorTickCount="0" snapToTicks="true" showTickLabels="true" showTickMarks="true" prefWidth="300"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <Button fx:id="btnAvaliar" text="Avaliar" styleClass="btn-primary" onAction="#avaliar"/>
                </HBox>
              </VBox>
              <VBox spacing="8" styleClass="panel"><padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                <Label text="Escrever review" styleClass="section-title"/>
                <TextField fx:id="txtTituloReview" promptText="título da review"/>
                <TextArea fx:id="txtTextoReview" promptText="escreva sua review..." wrapText="true" prefHeight="90"/>
                <HBox alignment="CENTER_RIGHT"><Button fx:id="btnPublicarReview" text="Publicar review" styleClass="btn-primary" onAction="#publicarReview"/></HBox>
              </VBox>
              <Label text="Reviews da comunidade" styleClass="section-title"/>
              <!-- Cada review será gerada em Java. Este é um exemplo de um card de review com comentários. -->
              <VBox fx:id="boxReviews" spacing="12">
                <VBox spacing="8" styleClass="review-card"><padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
                  <HBox alignment="CENTER_LEFT"><Label text="Título da review" styleClass="game-title"/><Region HBox.hgrow="ALWAYS"/><Label text="por nick • 15/11/2026" styleClass="game-meta"/></HBox>
                  <Label text="Texto descritivo da review..." wrapText="true" styleClass="muted"/>
                  <VBox spacing="6" styleClass="comment-box"><padding><Insets top="8" right="12" bottom="8" left="12"/></padding><Label text="nick2: comentário de exemplo" wrapText="true"/></VBox>
                  <HBox spacing="8"><TextField promptText="comentar..." HBox.hgrow="ALWAYS"/><Button text="Comentar" styleClass="btn-soft"/></HBox>
                </VBox>
              </VBox>
            </VBox>
          </ScrollPane>
        </HBox>
      </center>
    </BorderPane>
  </center>
</BorderPane>
