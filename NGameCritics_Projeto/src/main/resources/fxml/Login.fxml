<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.TelaController" prefWidth="1280" prefHeight="720" minWidth="1280" minHeight="720" maxWidth="1280" maxHeight="720" styleClass="auth-bg" stylesheets="@style.css">
  <HBox prefWidth="960" prefHeight="580" maxWidth="-Infinity" maxHeight="-Infinity" styleClass="auth-card">
    <VBox prefWidth="400" alignment="CENTER" spacing="14" styleClass="auth-left">
      <padding><Insets left="30" right="30"/></padding>
      <StackPane prefWidth="80" prefHeight="80" maxWidth="80" maxHeight="80" styleClass="badge-circle"><Label text="NG" styleClass="logo-text" style="-fx-font-size: 26px;"/></StackPane>
      <Label text="Bem-vindo!" styleClass="auth-left-title"/>
      <Label text="Acesse sua conta para continuar de onde parou." styleClass="auth-left-sub" wrapText="true"/>
    </VBox>
    <VBox prefWidth="560" alignment="CENTER_LEFT" spacing="8" styleClass="auth-right">
      <padding><Insets top="30" right="50" bottom="30" left="50"/></padding>
      <Label text="Entrar" styleClass="h1"/>
      <Label text="Digite seu usuário e senha" styleClass="muted"/>
      <Label text="Usuário" styleClass="field-label"><padding><Insets top="10"/></padding></Label>
      <TextField fx:id="txtUsuario" promptText="seu usuário"/>
      <Label text="Senha" styleClass="field-label"><padding><Insets top="6"/></padding></Label>
      <PasswordField fx:id="txtSenha" promptText="••••••••"/>
      <HBox alignment="CENTER_LEFT">
        <CheckBox fx:id="chkLembrar" text="Lembrar de mim"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Hyperlink fx:id="lnkEsqueci" text="Esqueci a senha" styleClass="link" onAction="#esqueciSenha"/>
      </HBox>
      <Label fx:id="lblErro" styleClass="error-label" visible="false" managed="false" text="Usuário ou senha inválidos"/>
      <Button fx:id="btnEntrar" text="ENTRAR" maxWidth="Infinity" styleClass="btn-primary" onAction="#entrar" defaultButton="true"/>
      <HBox alignment="CENTER" spacing="4"><Label text="Não tem conta?" styleClass="muted"/><Hyperlink fx:id="lnkCadastro" text="Cadastre-se" styleClass="link" onAction="#irCadastro"/></HBox>
    </VBox>
  </HBox>
</StackPane>
