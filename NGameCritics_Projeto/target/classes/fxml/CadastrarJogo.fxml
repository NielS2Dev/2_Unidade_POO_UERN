<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="720" maxWidth="1280" minHeight="720" minWidth="1280" prefHeight="720" prefWidth="1280" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.TelaController">
  <left>
    <VBox alignment="TOP_CENTER" prefWidth="240" spacing="8" styleClass="sidebar">
      <padding><Insets bottom="24" left="16" right="16" top="24" /></padding>
      <Label styleClass="sidebar-logo" text="NGameCritics"><padding><Insets bottom="20" left="6" /></padding></Label>
      <Button fx:id="btnCatalogo" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#irCatalogo" styleClass="nav-btn" text="Catálogo" />
      <Button fx:id="btnReviews" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#irMinhasReviews" styleClass="nav-btn" text="Minhas reviews" />
      <Button fx:id="btnAvaliacoes" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#irMinhasAvaliacoes" styleClass="nav-btn" text="Minhas avaliações" />
      <Button fx:id="btnCadastrar" alignment="CENTER_LEFT" graphicTextGap="20.0" lineSpacing="10.0" maxWidth="Infinity" onAction="#irCadastrarJogo" styleClass="nav-btn nav-btn-active" text="Cadastrar jogo">
            <opaqueInsets>
               <Insets />
            </opaqueInsets>
            <VBox.margin>
               <Insets />
            </VBox.margin>
            <padding>
               <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding></Button>
      <Region VBox.vgrow="ALWAYS" />
      <Button fx:id="btnSair" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#sair" styleClass="nav-btn" text="Sair" />
    </VBox>
  </left>
  <center>
    <BorderPane>
      <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68" spacing="12" styleClass="topbar">
          <padding><Insets left="28" right="28" /></padding>
          <Label styleClass="topbar-title" text="Cadastrar Novos Jogos " />
          <Region HBox.hgrow="ALWAYS" />
          <VBox alignment="CENTER_RIGHT"><Label fx:id="lblNick" styleClass="field-label" text="Antoniel" /><Label fx:id="lblNivel" styleClass="muted" text="ADM" /></VBox>
          <StackPane maxHeight="42" maxWidth="42" prefHeight="42" prefWidth="42" styleClass="avatar"><Label fx:id="lblInicial" styleClass="avatar-text" text="A" /></StackPane>
        </HBox>
      </top>
      <center>
        <VBox spacing="16" styleClass="content">
          <padding><Insets bottom="24" left="28" right="28" top="24" /></padding>
          <Label styleClass="h1" text="Cadastrar jogo" />
          <HBox spacing="28" styleClass="panel" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="24" left="28" right="28" top="24" /></padding>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
              <Label styleClass="field-label" text="Nome do Jogo Completo" />
              <TextField fx:id="txtNome" promptText="nome do jogo" />
              <Label styleClass="field-label" text="Preço em Reais (R$)" />
              <TextField fx:id="txtPreco" promptText="0,00" />
              <Label styleClass="field-label" text="Sinopse do Jogo" />
              <TextArea fx:id="txtResumo" prefHeight="150" promptText="resumo do jogo" wrapText="true" />
              <Label styleClass="field-label" text="Capa" />
              <HBox alignment="CENTER_LEFT" spacing="12"><Button fx:id="btnEscolherCapa" onAction="#escolherCapa" styleClass="btn-outline" text="Escolher imagem" /><Label fx:id="lblCapa" styleClass="muted" text="nenhum arquivo" /></HBox>
            </VBox>
            <VBox prefWidth="380" spacing="10">
              <Label styleClass="field-label" text="Gêneros" />
              <FlowPane hgap="16" vgap="10">
                <CheckBox fx:id="chkAcao" text="Ação" /><CheckBox fx:id="chkRPG" text="RPG" /><CheckBox fx:id="chkFPS" text="FPS" /><CheckBox fx:id="chkCorrida" text="Corrida" /><CheckBox fx:id="chkLuta" text="Luta" />
              </FlowPane>
              <Label styleClass="field-label" text="Plataformas"><padding><Insets top="10" /></padding></Label>
              <FlowPane hgap="16" vgap="10">
                <CheckBox fx:id="chkPC" text="PC" /><CheckBox fx:id="chkXbox" text="Xbox" /><CheckBox fx:id="chkPlayStation" text="PlayStation" /><CheckBox fx:id="chkSwitch" text="Switch" />
              </FlowPane>
              <Region VBox.vgrow="ALWAYS" />
              <Label fx:id="lblErro" managed="false" styleClass="error-label" visible="false" />
              <HBox alignment="CENTER_RIGHT" spacing="12"><Button fx:id="btnCancelar" onAction="#irCatalogo" styleClass="btn-outline" text="Cancelar" /><Button fx:id="btnSalvarJogo" onAction="#salvarJogo" styleClass="btn-primary" text="Salvar jogo" /></HBox>
            </VBox>
          </HBox>
        </VBox>
      </center>
    </BorderPane>
  </center>
</BorderPane>
