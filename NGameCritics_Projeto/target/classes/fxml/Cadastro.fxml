<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.TelaController" prefWidth="1280" prefHeight="720" minWidth="1280" minHeight="720" maxWidth="1280" maxHeight="720" styleClass="auth-bg" stylesheets="@style.css">
  <HBox prefWidth="960" prefHeight="580" maxWidth="-Infinity" maxHeight="-Infinity" styleClass="auth-card">
    <VBox prefWidth="400" alignment="CENTER" spacing="14" styleClass="auth-left">
      <padding><Insets left="30" right="30"/></padding>
      <StackPane prefWidth="80" prefHeight="80" maxWidth="80" maxHeight="80" styleClass="badge-circle"><Label text="NG" styleClass="logo-text" style="-fx-font-size: 26px;"/></StackPane>
      <Label text="Crie sua conta" styleClass="auth-left-title"/>
      <Label text="Entre para a comunidade, avalie e comente jogos." styleClass="auth-left-sub" wrapText="true"/>
    </VBox>
    <VBox prefWidth="560" alignment="CENTER_LEFT" spacing="8" styleClass="auth-right">
      <padding><Insets top="30" right="50" bottom="30" left="50"/></padding>
      <Label text="Cadastro" styleClass="h1"/>
      <Label text="Nome completo" styleClass="field-label"/>
      <TextField fx:id="txtNomeCompleto" promptText="seu nome completo"/>
      <Label text="Nick" styleClass="field-label"/>
      <TextField fx:id="txtNick" promptText="seu nick"/>
      <Label text="E-mail" styleClass="field-label"/>
      <TextField fx:id="txtEmail" promptText="voce@email.com"/>
      <Label text="Senha" styleClass="field-label"/>
      <PasswordField fx:id="txtSenha" promptText="••••••••"/>
      <Label text="Foto de perfil (opcional)" styleClass="field-label"/>
      <HBox alignment="CENTER_LEFT" spacing="12"><Button fx:id="btnEscolherFoto" text="Escolher imagem" styleClass="btn-outline" onAction="#escolherFoto"/><Label fx:id="lblArquivo" text="nenhum arquivo" styleClass="muted"/></HBox>
      <Label fx:id="lblErro" styleClass="error-label" visible="false" managed="false"/>
      <Button fx:id="btnCriarConta" text="CRIAR CONTA" maxWidth="Infinity" styleClass="btn-primary" onAction="#criarConta"/>
      <HBox alignment="CENTER" spacing="4"><Label text="Já tem conta?" styleClass="muted"/><Hyperlink fx:id="lnkEntrar" text="Entrar" styleClass="link" onAction="#irLogin"/></HBox>
    </VBox>
  </HBox>
</StackPane>
